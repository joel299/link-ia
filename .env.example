# Porta do servidor HTTP
PORT=3000
HOSTNAME=0.0.0.0

# Diretório para persistência do banco SQLite e uploads de avatar
DATA_DIR=./data

# Segredo para assinar cookies de sessão (trocar em produção, mínimo 16 caracteres)
SESSION_SECRET=change-me-to-a-long-random-secret

# Defina true apenas quando o acesso externo usar HTTPS
COOKIE_SECURE=false

# URL pública base da aplicação (usada em callbacks OAuth)
APP_BASE_URL=http://localhost:3000

# Integração Google Agenda via Composio (obrigatório em produção para Google Agenda real)
COMPOSIO_API_KEY=your-composio-api-key
COMPOSIO_GOOGLE_CALENDAR_AUTH_CONFIG_ID=your-google-calendar-auth-config-id
# Defina true apenas em dev local sem credenciais Composio para testar o fluxo simulado
COMPOSIO_ALLOW_LOCAL_MOCK=false

