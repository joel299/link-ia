# Porta do servidor HTTP
PORT=3000
HOSTNAME=0.0.0.0

# Diretório para persistência do banco SQLite e uploads de avatar
DATA_DIR=./data

# Segredo para assinar cookies de sessão (trocar em produção, mínimo 16 caracteres)
SESSION_SECRET=change-me-to-a-long-random-secret

# Segredo administrativo opcional para provisionamento via POST /api/auth/register (mínimo 16 caracteres)
ADMIN_PROVISION_SECRET=

# Opcional: provisionar primeiro usuário administrador no servidor (nunca exposto ao cliente)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Defina true apenas quando o acesso externo usar HTTPS
COOKIE_SECURE=false

# URL pública base da aplicação (usada em callbacks OAuth)
APP_BASE_URL=http://localhost:3000

# Integração Google Agenda via Composio (obrigatório em produção para Google Agenda real)
COMPOSIO_API_KEY=your-composio-api-key
COMPOSIO_GOOGLE_CALENDAR_AUTH_CONFIG_ID=your-google-calendar-auth-config-id
# Defina true apenas em dev local sem credenciais Composio para testar o fluxo simulado
COMPOSIO_ALLOW_LOCAL_MOCK=false

# Integrações Sociais e Tráfego Pago via Composio (opcionais; exibem configuração pendente se ausentes)
COMPOSIO_INSTAGRAM_AUTH_CONFIG_ID=your-instagram-auth-config-id
COMPOSIO_TIKTOK_AUTH_CONFIG_ID=your-tiktok-auth-config-id
COMPOSIO_TIKTOK_ADS_AUTH_CONFIG_ID=your-tiktok-ads-auth-config-id

# Meta Ads via Composio (credenciais da aplicação LinkIA no Meta for Developers)
META_ADS_CLIENT_ID=
META_ADS_CLIENT_SECRET=
COMPOSIO_META_ADS_AUTH_CONFIG_ID=
META_ADS_OAUTH_REDIRECT_URI=https://backend.composio.dev/api/v3/toolkits/auth/callback
LINKIA_META_ADS_RETURN_URL=https://linkia.iainfinito.com.br/api/integrations/social/callback
COMPOSIO_META_ADS_REDIRECT_URI=https://backend.composio.dev/api/v3/toolkits/auth/callback

# Integração WhatsApp Business com coexistência via Zernio
ZERNIO_API_KEY=your-zernio-api-key
ZERNIO_API_BASE_URL=https://zernio.com/api
ZERNIO_WEBHOOK_SECRET=
ZERNIO_ALLOW_LOCAL_MOCK=false

