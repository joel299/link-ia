{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurum-lex.local/design-system/tokens.schema.json",
  "title": "Aurum Lex Design Tokens",
  "type": "object",
  "required": [
    "name",
    "version"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "tokens": {
      "type": "object"
    },
    "tiers": {
      "type": "object"
    },
    "components": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
